{
  // Terminal > Run Task... Each one works in the Windows terminal (PowerShell) and on macOS or Linux.
  "version": "2.0.0",
  "tasks": [
    { "label": "Setup: install everything (npm install + Python tools)", "type": "shell",
      "command": "npm install && python3 -m pip install -r tools/requirements.txt",
      "windows": { "command": "npm install; python -m pip install -r tools/requirements.txt" }, "problemMatcher": [] },
    { "label": "Web page: start (http://localhost:8000)", "type": "shell", "command": "npm start",
      "isBackground": true, "problemMatcher": [] },
    { "label": "Web page: build into docs/", "type": "shell", "command": "npm run build", "group": "build", "problemMatcher": [] },
    { "label": "Test: web page", "type": "shell", "command": "npm test", "group": "test", "problemMatcher": [] },
    { "label": "Test: Python", "type": "shell", "command": "python3 -m unittest", "windows": { "command": "python -m unittest" },
      "group": "test", "problemMatcher": [] },
    { "label": "List the storybooks", "type": "shell", "command": "python3 -m coe books",
      "windows": { "command": "python -m coe books" }, "problemMatcher": [] },
    { "label": "Draw a storybook (asks for the book)", "type": "shell",
      "command": "python3 -m coe book ${input:book}",
      "windows": { "command": "python -m coe book ${input:book}" }, "problemMatcher": [] },
    { "label": "Update the list of pictures needed", "type": "shell", "command": "python3 tools/pictures_needed.py",
      "windows": { "command": "python tools/pictures_needed.py" }, "problemMatcher": [] },
    { "label": "List the 60 pictures", "type": "shell", "command": "python3 -m coe pictures",
      "windows": { "command": "python -m coe pictures" }, "problemMatcher": [] },
    { "label": "Re-trace the picture sheets", "type": "shell", "command": "python3 tools/trace_pictures.py",
      "windows": { "command": "python tools/trace_pictures.py" }, "problemMatcher": [] }
  ],
  "inputs": [
    { "id": "book", "type": "promptString", "description": "Book (e.g. Genesis, Tobit, \"1 John\")", "default": "Genesis" }
  ]
}
